# ---------------------------------------------------------------
# Template-Based PageSpeed Advisor: environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------

# Where aggregates come from: "apps-script" (production) or "mock" (local demo, synthetic data)
DATA_SOURCE=mock

# --- Apps Script data layer (required when DATA_SOURCE=apps-script) ---
# The /exec URL of the deployed web app (https://script.google.com/macros/s/.../exec)
APPS_SCRIPT_ENDPOINT=
# Must equal the API_TOKEN Script Property that the admin set in Apps Script
APPS_SCRIPT_TOKEN=

# --- Login (required) ---
# Random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# JSON array, wrapped in single quotes. Create hashes with: npm run hash-password
# Roles: ADMIN | DEVELOPER
AUTH_USERS='[{"username":"admin","role":"ADMIN","passwordHash":"<output of npm run hash-password>"},{"username":"dev","role":"DEVELOPER","passwordHash":"<output of npm run hash-password>"}]'
# Let DEVELOPER users trigger re-tests (true/false). Default true.
ALLOW_DEVELOPER_RETEST=true

# --- LLM (optional; without it the UI shows measured evidence only) ---
# anthropic | openai (any OpenAI-compatible endpoint, e.g. Groq) | gemini | ollama | mock (offline demo)
AI_PROVIDER=
AI_MODEL=
# Keep low for grounded output (clamped to 0..1)
AI_TEMPERATURE=0.1
# Max characters of evidence sent to the model
AI_MAX_INPUT_CHARS=24000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
